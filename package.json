{
  "name": "@obinexusltd/matlab-polycall",
  "version": "1.1.0",
  "description": "MATLAB MEX source binding for Polycall (binding ABI v1): runConfig, call, Peer",
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "build_matlab_polycall.m",
    "src/",
    "include/",
    "examples/",
    "tests/",
    "scripts/",
    "Makefile",
    "matlab-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "src",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "make",
    "build:mex": "make mex",
    "test": "node --test tests/package.test.js && node scripts/verify-dry.js",
    "test:core": "make test-core",
    "test:matlab": "make test-matlab",
    "test:octave": "make test-octave",
    "test:package": "node --test tests/package.test.js",
    "verify:dry": "node scripts/verify-dry.js",
    "verify": "npm test && make test-core",
    "prepack": "npm test",
    "test:loader:matlab": "make test-loader-matlab",
    "test:loader:octave": "make test-loader-octave"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/matlab-polycall.git"
  },
  "keywords": [
    "libpolycall",
    "polycall",
    "matlab",
    "mex",
    "ffi"
  ],
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/matlab-polycall/issues"
  },
  "homepage": "https://github.com/obinexus/matlab-polycall#readme"
}
