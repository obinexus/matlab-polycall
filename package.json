  "description": "MATLAB MEX source binding for libpolycall 1.5",
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "build_matlab_polycall.m",
    "src/",
    "include/",
    "generated/",
    "examples/",
    "tests/",
    "scripts/",
    "Makefile",
    "matlab-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "src",
    "example": "examples",
    "test": "tests"
